{
  "name": "ieee-hyderabad-sac-website",
  "version": "2.0.0",
  "description": "IEEE Hyderabad Student Activities Committee Website",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve --port=8080",
    "clean": "rimraf _site",
    "import:vtools": "node scripts/import-vtools.mjs",
    "format": "prettier --write \"**/*.{css,js,json,md,njk}\" --ignore-unknown",
    "format:check": "prettier --check \"**/*.{css,js,json,md,njk}\" --ignore-unknown"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "cheerio": "^1.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0"
  },
  "keywords": ["ieee", "website", "student-activities", "hyderabad"],
  "author": "IEEE Hyderabad SAC",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
