<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-logos">
          <a href="https://ieeehyderabad.org/" target="_blank" rel="noopener" aria-label="{{ nav.brand.primary_alt }}">
            <img src="{{ nav.brand.primary_logo }}" alt="{{ nav.brand.primary_alt }}" class="footer-logo-main" />
          </a>
          <a href="/sn-team/" aria-label="{{ nav.brand.secondary_alt }}">
            <img src="{{ nav.brand.secondary_logo }}" alt="{{ nav.brand.secondary_alt }}" class="footer-logo-sn" />
          </a>
        </div>
        <p class="footer-tagline">{{ nav.footer.tagline }}</p>
        <ul class="footer-social">
          {% for s in nav.footer.social %}
            <li>
              <a href="{{ s.href }}" target="_blank" rel="noopener" aria-label="{{ s.label }}">
                {% if s.icon == "facebook" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg>{% endif %}
                {% if s.icon == "instagram" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.4a4 4 0 1 1-8 .6 4 4 0 0 1 8-.6z"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>{% endif %}
                {% if s.icon == "linkedin" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 2h-17A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2zM8 19H5v-9h3zM6.5 8.3a1.7 1.7 0 1 1 0-3.5 1.7 1.7 0 0 1 0 3.5zM19 19h-3v-4.7c0-1.1-.4-1.9-1.4-1.9-.8 0-1.3.5-1.5 1.1v5.5h-3v-9h3v1.2A3.4 3.4 0 0 1 16 10c2.2 0 3 1.5 3 3.7z"/></svg>{% endif %}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>

      {% for group in nav.footer.groups %}
        <div>
          <h4>{{ group.heading }}</h4>
          <ul>
            {% for link in group.links %}
              <li><a href="{{ link.href }}"{% if link.external %} target="_blank" rel="noopener"{% endif %}>{{ link.label }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endfor %}

      <div>
        <h4>Address</h4>
        <p style="color: rgba(255,255,255,0.55); font-size: var(--fs-sm)">{{ nav.footer.address }}</p>
        {% if site.contact_email %}
          <p style="font-size: var(--fs-sm)"><a href="mailto:{{ site.contact_email }}">{{ site.contact_email }}</a></p>
        {% endif %}
      </div>
    </div>

    <div class="footer-bar">
      &copy; {{ global.currentYear }} IEEE Hyderabad Section Student Activities Committee. Built by the SAC Web Team.
    </div>
  </div>
</footer>
