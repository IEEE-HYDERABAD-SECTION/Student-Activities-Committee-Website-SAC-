---
pagination:
  data: events.all
  size: 1
  alias: event
permalink: "/events/{{ event.slug | safe }}/"
eleventyComputed:
  title: "{{ event.title }}"
  description: "{{ event.description }}"
layout: layouts/base.njk
---

<section class="section">
  <div class="container" style="max-width: 860px">

    <a href="/events/" style="display: inline-flex; align-items: center; gap: var(--s-2); color: var(--ink-mute); font-size: var(--fs-sm); text-decoration: none; margin-bottom: var(--s-6)" class="reveal">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      All Events
    </a>

    {% if event.poster %}
      <div class="reveal" style="margin-bottom: var(--s-6)">
        <img src="{{ event.poster }}" alt="{{ event.title }}" style="width: 100%; border-radius: var(--r-lg); max-height: 480px; object-fit: cover; box-shadow: var(--sh-3)" loading="eager" />
      </div>
    {% endif %}

    <div class="reveal" style="display: flex; flex-wrap: wrap; gap: var(--s-2); margin-bottom: var(--s-4)">
      <span class="pill {% if event.status == 'past' %}pill-past{% else %}pill-upcoming{% endif %}">
        {{ "Past Event" if event.status == "past" else "Upcoming" }}
      </span>
      {% if event.mode %}
        <span class="pill" style="background: var(--surface-alt); color: var(--ink-mute)">{{ event.mode }}</span>
      {% endif %}
      {% for tag in event.tags %}
        <span class="pill" style="background: color-mix(in srgb, var(--ieee-blue) 12%, transparent); color: var(--ieee-blue)">{{ tag }}</span>
      {% endfor %}
    </div>

    <h1 class="reveal" style="font-size: clamp(var(--fs-xl), 4vw, var(--fs-2xl)); line-height: 1.2; margin-bottom: var(--s-5)">{{ event.title }}</h1>

    <div class="card reveal" style="padding: var(--s-5); margin-bottom: var(--s-6); display: flex; flex-direction: column; gap: var(--s-3)">
      {% if event.date %}
        <div style="display: flex; align-items: center; gap: var(--s-3); font-size: var(--fs-sm)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--ieee-blue)" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span>
            <strong>{{ event.date | displayDate }}</strong> at {{ event.date | displayTime }}
            {% if event.end_date %}&ndash;{{ event.end_date | displayTime }}{% endif %}
          </span>
        </div>
      {% endif %}
      {% if event.venue %}
        <div style="display: flex; align-items: center; gap: var(--s-3); font-size: var(--fs-sm)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--ieee-blue)" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>{{ event.venue }}</span>
        </div>
      {% endif %}
      {% if event.vtools_id %}
        <div style="display: flex; align-items: center; gap: var(--s-3); font-size: var(--fs-sm)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--ieee-blue)" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <a href="https://events.vtools.ieee.org/m/{{ event.vtools_id }}" target="_blank" rel="noopener" style="color: var(--ieee-blue)">IEEE vTools #{{ event.vtools_id }}</a>
        </div>
      {% endif %}
    </div>

    {% if event.description %}
      <div class="reveal" style="margin-bottom: var(--s-7)">
        <h2 style="font-size: var(--fs-lg); margin-bottom: var(--s-4)">About this Event</h2>
        <p style="white-space: pre-wrap; color: var(--ink-soft); line-height: 1.8">{{ event.description }}</p>
      </div>
    {% endif %}

    {% if event.content and event.content.length %}
      <div class="event-content reveal">
        {% for block in event.content %}
          {% if block.type == "heading" and block.text %}
            <h2>{{ block.text }}</h2>
          {% elif block.type == "image" and block.src %}
            <figure class="event-content-image">
              <img src="{{ block.src }}" alt="{{ block.alt or event.title }}" loading="lazy" />
              {% if block.caption %}
                <figcaption>{{ block.caption }}</figcaption>
              {% endif %}
            </figure>
          {% elif block.text %}
            <p>{{ block.text }}</p>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if event.images and event.images.length %}
      <section class="event-gallery reveal" aria-labelledby="event-gallery-title">
        <span class="eyebrow">Event Photos</span>
        <h2 id="event-gallery-title">Moments from this event</h2>
        <div class="event-photo-grid">
          {% for image in event.images %}
            <figure class="event-photo">
              <img src="{{ image.src or image }}" alt="{{ image.alt or event.title }}" loading="lazy" />
              {% if image.caption %}
                <figcaption>{{ image.caption }}</figcaption>
              {% endif %}
            </figure>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <div class="reveal" style="display: flex; flex-wrap: wrap; gap: var(--s-3)">
      {% if event.register_url and event.status != "past" %}
        <a class="btn btn-primary" href="{{ event.register_url }}" target="_blank" rel="noopener">
          Register Now
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      {% endif %}
      {% if event.register_url %}
        <a class="btn btn-ghost" href="{{ event.register_url }}" target="_blank" rel="noopener">View on vTools</a>
      {% endif %}
      <a class="btn btn-ghost" href="/events/">← Back to Events</a>
    </div>

  </div>
</section>
