---
layout: layouts/base.njk
title: Flagship Events
description: Major IEEE Hyderabad SAC flagship events, congresses, and recurring student programs.
permalink: /flagship-events/
---

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Congress & Flagship</span>
      <h1>Flagship Events</h1>
      <p>Major recurring SAC programs, student congresses, and section-wide initiatives.</p>
    </div>

    {% if flagshipEvents.all.length %}
      <div class="grid grid-3">
        {% for item in flagshipEvents.all %}
          {% set editions = flagshipEditions.byFlagship[item.slug] or [] %}
          <article class="card reveal">
            {% if item.cover_image %}
              <a href="/flagship-events/{{ item.slug }}/" class="card-image" style="display: block">
                <img src="{{ item.cover_image }}" alt="{{ item.title }}" loading="lazy" />
              </a>
            {% endif %}
            <div class="card-body">
              <div class="flex" style="justify-content: space-between; align-items: center; gap: var(--s-3)">
                {% if item.category %}<span class="pill">{{ item.category }}</span>{% endif %}
                {% if editions.length %}<span class="pill" style="background: var(--surface-alt); color: var(--ink-mute)">{{ editions.length }} edition{% if editions.length != 1 %}s{% endif %}</span>{% endif %}
              </div>
              <h3><a href="/flagship-events/{{ item.slug }}/" style="color: inherit">{{ item.title }}</a></h3>
              {% if item.tagline %}<p style="margin: 0; color: var(--ieee-blue); font-size: var(--fs-sm); font-weight: 700">{{ item.tagline }}</p>{% endif %}
              {% if item.short_description %}<p style="margin: 0; font-size: var(--fs-sm)">{{ item.short_description }}</p>{% endif %}
              <a class="btn btn-primary btn-sm" href="/flagship-events/{{ item.slug }}/" style="align-self: flex-start; margin-top: auto">
                View Program
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p style="text-align: center; color: var(--ink-mute); padding: var(--s-7) 0">No flagship events have been added yet.</p>
    {% endif %}
  </div>
</section>
