---
pagination:
  data: flagshipEvents.all
  size: 1
  alias: flagship
permalink: "/flagship-events/{{ flagship.slug | safe }}/"
eleventyComputed:
  title: "{{ flagship.title }}"
  description: "{{ flagship.short_description }}"
layout: layouts/base.njk
---

{% set editions = flagshipEditions.byFlagship[flagship.slug] or [] %}

<section class="section">
  <div class="container" style="max-width: 920px">
    <a href="/flagship-events/" style="display: inline-flex; align-items: center; gap: var(--s-2); color: var(--ink-mute); font-size: var(--fs-sm); text-decoration: none; margin-bottom: var(--s-6)" class="reveal">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      All Flagship Events
    </a>

    {% if flagship.cover_image %}
      <div class="reveal" style="margin-bottom: var(--s-6)">
        <img src="{{ flagship.cover_image }}" alt="{{ flagship.title }}" style="width: 100%; border-radius: var(--r-lg); max-height: 500px; object-fit: cover; box-shadow: var(--sh-3)" loading="eager" />
      </div>
    {% endif %}

    <div class="reveal" style="display: flex; flex-wrap: wrap; gap: var(--s-2); margin-bottom: var(--s-4)">
      {% if flagship.category %}<span class="pill">{{ flagship.category }}</span>{% endif %}
      {% if flagship.frequency %}<span class="pill" style="background: var(--surface-alt); color: var(--ink-mute)">{{ flagship.frequency }}</span>{% endif %}
      {% if flagship.started_year %}<span class="pill" style="background: var(--surface-alt); color: var(--ink-mute)">Since {{ flagship.started_year }}</span>{% endif %}
      {% for tag in flagship.tags %}
        <span class="pill" style="background: color-mix(in srgb, var(--ieee-blue) 12%, transparent); color: var(--ieee-blue)">{{ tag }}</span>
      {% endfor %}
    </div>

    <h1 class="reveal" style="font-size: clamp(var(--fs-xl), 4vw, var(--fs-2xl)); line-height: 1.2; margin-bottom: var(--s-3)">{{ flagship.title }}</h1>
    {% if flagship.tagline %}<p class="reveal" style="color: var(--ieee-blue); font-weight: 700; margin-bottom: var(--s-5)">{{ flagship.tagline }}</p>{% endif %}

    {% if flagship.short_description %}
      <p class="reveal" style="font-size: var(--fs-md); line-height: 1.8">{{ flagship.short_description }}</p>
    {% endif %}

    {% if flagship.stats and flagship.stats.length %}
      <div class="stats reveal" style="margin-top: var(--s-6); margin-bottom: var(--s-7)">
        {% for stat in flagship.stats %}
          <div class="stat">
            <span class="stat-value">{{ stat.value }}</span>
            <span class="stat-label">{{ stat.label }}</span>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if flagship.long_description %}
      <div class="event-content reveal" style="margin-top: var(--s-7)">
        <h2>About the Program</h2>
        <p>{{ flagship.long_description }}</p>
      </div>
    {% endif %}

    {% if flagship.highlights and flagship.highlights.length %}
      <section class="event-content reveal">
        <h2>Highlights</h2>
        <div class="grid grid-3">
          {% for highlight in flagship.highlights %}
            <div class="card card-glass" style="padding: var(--s-5)">
              <p style="margin: 0">{{ highlight }}</p>
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if editions.length %}
      <section class="event-gallery reveal" aria-labelledby="flagship-editions-title">
        <span class="eyebrow">Editions</span>
        <h2 id="flagship-editions-title">Year-wise Editions</h2>
        <div class="grid grid-3">
          {% for edition in editions %}
            <article class="card">
              {% if edition.cover_image %}
                <a href="/flagship-events/{{ flagship.slug }}/{{ edition.slug }}/" class="card-image" style="display: block">
                  <img src="{{ edition.cover_image }}" alt="{{ edition.title }}" loading="lazy" />
                </a>
              {% endif %}
              <div class="card-body">
                <div class="card-meta">
                  {% if edition.year %}<span>{{ edition.year }}</span>{% endif %}
                  {% if edition.venue %}<span>{{ edition.venue }}</span>{% endif %}
                </div>
                <h3><a href="/flagship-events/{{ flagship.slug }}/{{ edition.slug }}/" style="color: inherit">{{ edition.title }}</a></h3>
                {% if edition.summary %}<p style="margin: 0; font-size: var(--fs-sm)">{{ edition.summary }}</p>{% endif %}
                <a class="btn btn-ghost btn-sm" href="/flagship-events/{{ flagship.slug }}/{{ edition.slug }}/" style="align-self: flex-start; margin-top: auto">View Edition</a>
              </div>
            </article>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if flagship.gallery and flagship.gallery.length %}
      <section class="event-gallery reveal" aria-labelledby="flagship-gallery-title">
        <span class="eyebrow">Gallery</span>
        <h2 id="flagship-gallery-title">Program Highlights</h2>
        <div class="event-photo-grid">
          {% for image in flagship.gallery %}
            <figure class="event-photo">
              <img src="{{ image.src or image }}" alt="{{ image.alt or flagship.title }}" loading="lazy" />
              {% if image.caption %}
                <figcaption>{{ image.caption }}</figcaption>
              {% endif %}
            </figure>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <div class="reveal" style="display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-7)">
      <a class="btn btn-ghost" href="/flagship-events/">Back to Flagship Events</a>
    </div>
  </div>
</section>
