---
layout: layouts/base.njk
title: Photo Gallery
description: Photos from IEEE Hyderabad SAC events and activities.
permalink: /gallery/
---

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Resources</span>
      <h1>Photo Gallery</h1>
      <p>Moments from IEEE Hyderabad SAC events and activities.</p>
    </div>

    {% for group in gallery %}
      <h2 class="reveal" style="margin-bottom: var(--s-5)">{{ group.year }}</h2>
      <div class="gallery-grid" {% if not loop.last %}style="margin-bottom: var(--s-8)"{% endif %}>
        {% for photo in group.photos %}
          <div class="gallery-item reveal">
            <img src="{{ photo.src }}" alt="{{ photo.alt or 'IEEE SAC gallery photo' }}" loading="lazy" />
            {% if photo.caption %}
              <div class="gallery-caption">{{ photo.caption }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</section>
