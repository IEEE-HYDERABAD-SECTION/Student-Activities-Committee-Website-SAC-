<style>
  .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--s-4); }
  .gallery-item { border-radius: var(--r-lg); overflow: hidden; aspect-ratio: 4 / 3; background: var(--surface-alt); position: relative; }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-slow) var(--ease); }
  .gallery-item:hover img { transform: scale(1.06); }
  .gallery-caption { position: absolute; bottom: 0; left: 0; right: 0; padding: var(--s-3) var(--s-4); background: linear-gradient(transparent, rgba(11,31,58,0.85)); color: white; font-size: var(--fs-xs); font-weight: 600; opacity: 0; transition: opacity var(--dur-base) var(--ease); }
  .gallery-item:hover .gallery-caption { opacity: 1; }
</style>

